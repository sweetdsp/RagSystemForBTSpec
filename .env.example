# Copy to .env and fill in what you need:  cp .env.example .env
# .env is git-ignored. Real environment variables take precedence over this file.

# --- OpenAI (embeddings text-embedding-3-* and chat models) -------------------
OPENAI_API_KEY=
# Comma-separated chat models offered in the UI
OPENAI_CHAT_MODELS=gpt-4o-mini,gpt-4.1-mini,gpt-4o

# --- Ollama (local LLMs / embeddings: `ollama serve`) -------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODELS=llama3.2,qwen2.5,mistral

# --- Documents ----------------------------------------------------------------
# Default PDF used when nothing is uploaded (falls back to the bundled primer)
DEFAULT_PDF_PATH=data/bluetooth_core_spec.pdf
# Optional cap on the default "last page" (0 = whole document; pick sections in the sidebar)
DEFAULT_PAGE_LIMIT=0
# Where parsed page text and bookmarks are cached (default: .cache/ in the project)
# RAG_CACHE_DIR=.cache
MAX_UPLOAD_MB=300

# --- Performance / memory guards ------------------------------------------------
MAX_CHUNKS_PER_INDEX=60000
EMBED_BATCH_SIZE=128
MAX_PARALLEL_WORKERS=5
LLM_REQUEST_TIMEOUT=120
